  "formulas": [
    {
      "db": "tasks",
      "name": "D-day",
      "expression": "if(prop(\"상태\") == \"완료\", \"✅ 완료\", if(empty(prop(\"마감\")), \"\", let(d, dateBetween(prop(\"마감\"), today(), \"days\"), if(d == 0, \"🔥 오늘 마감\", if(d < 0, \"⚠️ \" + format(abs(d)) + \"일 지남\", \"D-\" + format(d))))))"
    },
    {
      "db": "raw",
      "name": "정리 알림",
      "expression": "if(prop(\"정리 상태\") == \"📥 미정리\" and not empty(prop(\"날짜\")), let(n, dateBetween(today(), prop(\"날짜\"), \"days\"), if(n >= 7, \"⏰ \" + format(n) + \"일째 대기\", \"\")), \"\")"
    },
    {
      "db": "activities",
      "name": "포트폴리오 준비도",
      "description": "RAW → WIKI → OUTPUT 중 어디까지 왔는지",
      "expression": "if(prop(\"결과물 수\") > 0, \"🏆 결과물 있음\", if(prop(\"위키 수\") > 0, \"📚 위키 정리됨\", if(prop(\"RAW 수\") > 0, \"📥 기록만 있음\", \"✏️ 첫 기록 필요\")))"
    }
  ],
